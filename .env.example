# =============================================================
# RichardLSenninger.com — Environment Variables
# Copy to .env locally, or set in Railway dashboard for production.
# NEVER commit the real .env file (it's in .gitignore).
# =============================================================

# --- Server ---
# Railway sets PORT automatically; only set this locally.
PORT=3456

# --- Stripe (store checkout) ---
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
# Optional — for webhook signature verification (set after deploying & registering webhook)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_KEY_HERE

# --- Printify (print-on-demand merch) ---
# Get from https://printify.com/app/account/api
PRINTIFY_API_KEY=YOUR_PRINTIFY_API_KEY
PRINTIFY_SHOP_ID=YOUR_PRINTIFY_SHOP_ID

# --- Brevo (newsletter subscribe via /api/subscribe) ---
# Get from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-YOUR_KEY_HERE
BREVO_LIST_ID=2

# --- Google Calendar (optional — for scheduled appearances) ---
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GOOGLE_CALENDAR_ID=primary
REFRESH_TOKEN=YOUR_OAUTH_REFRESH_TOKEN
